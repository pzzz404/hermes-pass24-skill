# Pass24 API (mobile endpoint). Hermes keeps this file outside the repository
# and passes its path through PASS24_ENV_FILE.
PASS24_BASE_URL=https://mobile-api.pass24online.ru/v1
# Pass24 sends the login form under the `email` key, but its value must be the
# phone number used to sign in to the Pass24 app — not an email address.
PASS24_PHONE=+7XXXXXXXXXX
PASS24_PASSWORD=your_password_here

# Ваши идентификаторы в Pass24 (уточните у управляющей компании или в приложении)
PASS24_ADDRESS_ID=0
PASS24_TENANT_ID=0
PASS24_VEHICLE_TYPE=404
